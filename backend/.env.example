# ─── Сервер ───────────────────────────────────────────────
# production | development (в development ошибки API показывают текст, CORS открыт)
APP_ENV=production
# Адрес сайта для ссылок на загруженные картинки. Пусто — ссылки вида /uploads/… (подходит почти всегда)
PUBLIC_URL=
# Через запятую. Сайт и API на одном домене — оставьте пустым
CORS_ORIGINS=
# Сайт за Cloudflare / прокси: true — брать IP из X-Forwarded-For (для анти-спама)
TRUST_PROXY=false

# ─── Тип сайта ───────────────────────────────────────────
# landing | cafe | entertainment | shop
SITE_PRESET=shop
# Явный список модулей (перекрывает пресет): pages,leads,media,menu,booking,shop
MODULES=

# ─── База данных MySQL / MariaDB ─────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=handmade
DB_USER=root
DB_PASS=

# ─── Админка ─────────────────────────────────────────────
# Длинная случайная строка, не короче 32 символов
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Админ создаётся при первом входе (если в базе ещё нет админов). Потом смените пароль в админке.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ─── Бронирование ────────────────────────────────────────
TIMEZONE=Europe/Moscow
BOOKING_SLOT_STEP_MIN=30
# За сколько минут до начала можно бронировать
BOOKING_MIN_LEAD_MIN=60
# На сколько дней вперёд открыта запись
BOOKING_MAX_DAYS_AHEAD=60
# Сразу подтверждать брони (иначе статус pending до подтверждения админом)
BOOKING_AUTO_CONFIRM=false
# Клиент может отменить бронь не позже чем за N часов
BOOKING_CANCEL_MIN_HOURS=3

# ─── Уведомления (необязательно) ─────────────────────────
TELEGRAM_BOT_TOKEN=
# Можно несколько через запятую
TELEGRAM_CHAT_ID=

# Без SMTP_HOST письма уходят через mail() хостинга
SMTP_HOST=
SMTP_PORT=465
# true — SSL (порт 465), false — STARTTLS (порт 587)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Сайт <noreply@example.com>"
# Куда слать уведомления админу (через запятую)
MAIL_ADMIN_TO=

# ─── Загрузки ────────────────────────────────────────────
# Папка относительно backend/ — должна быть внутри папки сайта
UPLOAD_DIR=../uploads
UPLOAD_MAX_MB=10
